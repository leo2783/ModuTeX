{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM"],
		"types": [],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts"]
}
