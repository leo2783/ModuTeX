{
	"name": "texpile-typst-syntax-wasm",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Typst's official parser as a Lezer parser for CodeMirror",
	"license": "Apache-2.0",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"_comment:build:wasm": "The committed pkg directory avoids requiring Rust in normal builds.",
		"build:wasm": "wasm-pack build --release --no-pack --target=bundler --out-dir=pkg && node scripts/postbuild.mjs",
		"test": "vitest run"
	},
	"dependencies": {
		"@lezer/common": "1.5.2",
		"@lezer/highlight": "1.2.3"
	},
	"devDependencies": {
		"vite-plugin-wasm": "3.6.0",
		"vitest": "4.1.10"
	}
}
