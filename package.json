{
	"name": "modutex-desktop",
	"version": "0.3.0",
	"private": true,
	"description": "ModuTeX desktop LaTeX editor",
	"author": "ModuTeX contributors",
	"license": "Apache-2.0",
	"homepage": "https://github.com/leo2783/ModuTeX",
	"packageManager": "npm@11.19.1",
	"engines": {
		"node": "24.22.1",
		"npm": "11.19.1"
	},
	"workspaces": [
		"apps/frontend",
		"packages/frontend-contracts",
		"landing"
	],
	"scripts": {
		"build": "npm run tauri:build",
		"sync": "npm run sync --workspaces --if-present",
		"verify:vendor": "node scripts/verify-vendor.mjs",
		"test:tauri-ci-policy": "node --test tests/scripts/tauri-ci-policy.test.mjs tests/scripts/native-cdp-config.test.mjs",
		"test:dependency-security": "node --test tests/scripts/dependency-security-runtime.test.mjs",
		"verify:install-policy": "node scripts/verify-install-policy.mjs",
		"test:install-policy": "node --test tests/scripts/verify-install-policy.test.mjs",
		"set-version": "node scripts/set-version.mjs",
		"app:build": "npm run tauri:build",
		"format": "prettier --write .",
		"frontend:check": "npm run check --workspace=modutex-frontend",
		"frontend:build": "npm run build --workspace=modutex-frontend",
		"frontend:build:tauri": "npm run build --workspace=modutex-frontend -- --mode tauri",
		"frontend:test": "npm run test --workspace=modutex-frontend",
		"verify:frontend-origin": "node scripts/licensing/verify-frontend-origin.mjs",
		"pretest:frontend-origin": "npm run frontend:build",
		"test:frontend-origin": "node --test tests/scripts/licensing/*.test.mjs",
		"tauri": "\"apps\\desktop-tauri\\target\\release\\modutex-desktop-tauri.exe\"",
		"tauri:build": "npm run frontend:build:tauri && cargo build --locked --release --manifest-path apps/desktop-tauri/Cargo.toml",
		"tauri:bundle": "cd apps/desktop-tauri && npx --no-install tauri bundle --no-binary-patching --no-sign --ci --bundles nsis",
		"tauri:bundle:offline": "cd apps/desktop-tauri && npx --no-install tauri bundle --config tauri.offline.conf.json --no-binary-patching --no-sign --ci --bundles nsis",
		"tauri:package": "npm run tauri:build && npm run tauri:bundle",
		"tauri:package:offline": "npm run tauri:build && npm run tauri:bundle:offline"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.3",
		"@types/node": "24.13.3",
		"esbuild": "0.28.1",
		"js-yaml": "4.3.2",
		"playwright": "1.61.1",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.0",
		"typescript": "6.0.3"
	},
	"overrides": {
		"@xmldom/xmldom": "0.8.15",
		"@sveltejs/kit": {
			"cookie": "0.7.2"
		},
		"@tailwindcss/typography": {
			"postcss-selector-parser": "7.1.7"
		},
		"brace-expansion@^1": "1.1.21",
		"brace-expansion@^2": "2.1.7",
		"brace-expansion@^5": "5.0.12",
		"fast-uri": "3.1.8",
		"joi": "18.2.9",
		"js-yaml": "4.3.2",
		"svelte": "5.56.9",
		"undici@^6": "6.28.1",
		"undici@^7": "7.30.1",
		"source-map-js": "1.2.2",
		"proxy-addr": "2.0.8",
		"vite": "8.3.5",
		"vitest": "4.1.12"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.2": false,
		"fsevents@2.3.3": false
	}
}
